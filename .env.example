# Public build-time configuration. These values are embedded in the browser
# bundle, so never put secrets here. The Supabase anon key is designed to be
# public; never use the service-role key.

# Base URL of the Elniv API, without a trailing slash or /api/v1
ELNIV_API_URL=http://localhost:8000

# Your Supabase project URL and anon (public) key
ELNIV_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
ELNIV_SUPABASE_ANON_KEY=your-supabase-anon-key
